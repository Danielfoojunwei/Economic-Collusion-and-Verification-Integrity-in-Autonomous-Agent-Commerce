{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-economic-trust/event.v1.schema.json",
  "title": "Research execution event v1 (proposed)",
  "type": "object",
  "required": ["schema_version", "run_id", "experiment_id", "episode_id", "event_id", "seq", "timestamp_utc", "actor_id", "actor_role", "event_type", "task_id", "status", "model_behavior_tier", "payment_tier"],
  "properties": {
    "schema_version": {"const": "1"},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "parent_event_id": {"type": ["string", "null"]},
    "seq": {"type": "integer", "minimum": 0},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "actor_id": {"type": "string"},
    "actor_role": {"enum": ["client", "provider", "verifier", "payer", "settlement", "registry", "oracle", "marketplace", "system"]},
    "event_type": {"type": "string", "minLength": 1},
    "task_id": {"type": "string"},
    "obligation_id": {"type": ["string", "null"]},
    "protocol_name": {"type": ["string", "null"]},
    "protocol_version": {"type": ["string", "null"]},
    "model_behavior_tier": {"enum": ["SCRIPTED", "REAL_LLM_LOCAL", "REAL_LLM_REMOTE_APPROVED", "NO_MODEL"]},
    "payment_tier": {"enum": ["MOCK_LOCAL", "NATIVE_LOCAL_CHAIN", "NATIVE_LOCAL_FACILITATOR", "NATIVE_TESTNET_APPROVED", "NO_PAYMENT"]},
    "artifact_digest": {"type": ["string", "null"]},
    "evidence_digest": {"type": ["string", "null"]},
    "payment_reference": {"type": ["string", "null"]},
    "amount_minor_units": {"type": ["integer", "null"], "minimum": 0},
    "currency": {"type": ["string", "null"]},
    "status": {"enum": ["SUCCESS", "FAIL", "SKIP", "ERROR", "INCONCLUSIVE", "PENDING"]},
    "payload": {"type": "object"}
  },
  "additionalProperties": true
}
